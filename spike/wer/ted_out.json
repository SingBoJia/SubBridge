				"to": 238760
			},
			"text": " And, damn it, I'm going to see it through."
		},
		{
			"timestamps": {
				"from": "00:03:59,780",
				"to": "00:04:06,780"
			},
			"offsets": {
				"from": 239780,
				"to": 246780
			},
			"text": " Now, if you take a look behind me, these are just words paired with vaguely thought-provoking"
		},
		{
			"timestamps": {
				"from": "00:04:06,780",
				"to": "00:04:07,580"
			},
			"offsets": {
				"from": 246780,
				"to": 247580
			},
			"text": " stock photos."
		},
		{
			"timestamps": {
				"from": "00:04:08,360",
				"to": "00:04:12,160"
			},
			"offsets": {
				"from": 248360,
				"to": 252160
			},
			"text": " I'm going to point at them like I'm making use both of my time as well as your time."
		},
		{
			"timestamps": {
				"from": "00:04:12,460",
				"to": "00:04:14,820"
			},
			"offsets": {
				"from": 252460,
				"to": 254820
			},
			"text": " But in reality, I don't know what half of them mean."
		},
		{
			"timestamps": {
				"from": "00:04:15,640",
				"to": "00:04:18,540"
			},
			"offsets": {
				"from": 255640,
				"to": 258540
			},
			"text": " And now, as these continue, I'm just going to start saying gibberish."
		},
		{
			"timestamps": {
				"from": "00:04:19,200",
				"to": "00:04:21,000"
			},
			"offsets": {
				"from": 259200,
				"to": 261000
			},
			"text": " Wag-a-wah, gabba-gabba."
		},
		{
			"timestamps": {
				"from": "00:04:21,680",
				"to": "00:04:23,540"
			},
			"offsets": {
				"from": 261680,
				"to": 263540
			},
			"text": " Turkey, mouth-in-a-mouth."
		},
		{
			"timestamps": {
				"from": "00:04:24,420",
				"to": "00:04:26,500"
			},
			"offsets": {
				"from": 264420,
				"to": 266500
			},
			"text": " Chip, trip, my dog Skip."
		},
		{
			"timestamps": {
				"from": "00:04:27,060",
				"to": "00:04:28,420"
			},
			"offsets": {
				"from": 267060,
				"to": 268420
			},
			"text": " Rip it and dip it, Richard."
		},
		{
			"timestamps": {
				"from": "00:04:29,280",
				"to": "00:04:32,420"
			},
			"offsets": {
				"from": 269280,
				"to": 272420
			},
			"text": " I'm an itty-bitty baby bopper, and I'm hungry in my tum-tum."
		},
		{
			"timestamps": {
				"from": "00:04:33,380",
				"to": "00:04:35,240"
			},
			"offsets": {
				"from": 273380,
				"to": 275240
			},
			"text": " Brad Pitt, Uma Thurman."
		},
		{
			"timestamps": {
				"from": "00:04:36,280",
				"to": "00:04:39,860"
			},
			"offsets": {
				"from": 276280,
				"to": 279860
			},
			"text": " Names, things, words, words, and more things."
		},
		{
			"timestamps": {
				"from": "00:04:39,980",
				"to": "00:04:42,360"
			},
			"offsets": {
				"from": 279980,
				"to": 282360
			},
			"text": " And see, it feels like it might make sense, doesn't it?"
		},
		{
			"timestamps": {
				"from": "00:04:43,500",
				"to": "00:04:47,100"
			},
			"offsets": {
				"from": 283500,
				"to": 287100
			},
			"text": " Like maybe, just maybe, I'm building to some sort of satisfying conclusion."
		},
		{
			"timestamps": {
				"from": "00:04:47,280",
				"to": "00:04:49,000"
			},
			"offsets": {
				"from": 287280,
				"to": 289000
			},
			"text": " I mean, I'm gesticulating as though I am."
		},
		{
			"timestamps": {
				"from": "00:04:49,420",
				"to": "00:04:51,080"
			},
			"offsets": {
				"from": 289420,
				"to": 291080
			},
			"text": " I'm pacing, I'm growing in intensity."
		},
		{
			"timestamps": {
				"from": "00:04:51,240",
				"to": "00:04:53,600"
			},
			"offsets": {
				"from": 291240,
				"to": 293600
			},
			"text": " I'm taking off my glasses, which, by the way, are just frames."
		},
		{
			"timestamps": {
				"from": "00:04:59,280",
				"to": "00:05:05,280"
			},
			"offsets": {
				"from": 299280,
				"to": 305280
			},
			"text": " I wore them to look smart, even though my vision is perfect."
		},
		{
			"timestamps": {
				"from": "00:05:07,800",
				"to": "00:05:09,200"
			},
			"offsets": {
				"from": 307800,
				"to": 309200
			},
			"text": " And now I'm going to slow things down a little bit."
		},
		{
			"timestamps": {
				"from": "00:05:10,140",
				"to": "00:05:11,180"
			},
			"offsets": {
				"from": 310140,
				"to": 311180
			},
			"text": " I'm going to change the tone."
		},
		{
			"timestamps": {
				"from": "00:05:13,180",
				"to": "00:05:17,260"
			},
			"offsets": {
				"from": 313180,
				"to": 317260
			},
			"text": " I'm going to make it seem like I'm building to a moment."
		},
		{
			"timestamps": {
				"from": "00:05:20,540",
				"to": "00:05:21,840"
			},
			"offsets": {
				"from": 320540,
				"to": 321840
			},
			"text": " And what if I was?"
		},
		{
			"timestamps": {
				"from": "00:05:24,660",
				"to": "00:05:25,500"
			},
			"offsets": {
				"from": 324660,
				"to": 325500
			},
			"text": " Amazing, isn't it?"
		},
		{
			"timestamps": {
				"from": "00:05:25,720",
				"to": "00:05:26,240"
			},
			"offsets": {
				"from": 325720,
				"to": 326240
			},
			"text": " What can you do?"
		},
		{
			"timestamps": {
				"from": "00:05:26,700",
				"to": "00:05:27,960"
			},
			"offsets": {
				"from": 326700,
				"to": 327960
			},
			"text": " Life's a roller coaster."
		},
		{
			"timestamps": {
				"from": "00:05:32,600",
				"to": "00:05:35,780"
			},
			"offsets": {
				"from": 332600,
				"to": 335780
			},
			"text": " You know, if there's one thing you take away from my talk,"
		},
		{
			"timestamps": {
				"from": "00:05:35,920",
				"to": "00:05:37,540"
			},
			"offsets": {
				"from": 335920,
				"to": 337540
			},
			"text": " I'd like you to think about what you heard at the beginning."
		},
		{
			"timestamps": {
				"from": "00:05:38,540",
				"to": "00:05:40,800"
			},
			"offsets": {
				"from": 338540,
				"to": 340800
			},
			"text": " And I'd like you to think about what you hear now."
		},
		{
			"timestamps": {
				"from": "00:05:42,400",
				"to": "00:05:45,460"
			},
			"offsets": {
				"from": 342400,
				"to": 345460
			},
			"text": " Because it was nothing, and it's still nothing."
		},
		{
			"timestamps": {
				"from": "00:05:45,560",
				"to": "00:05:46,240"
			},
			"offsets": {
				"from": 345560,
				"to": 346240
			},
			"text": " Think about that."
		},
		{
			"timestamps": {
				"from": "00:05:47,300",
				"to": "00:05:48,540"
			},
			"offsets": {
				"from": 347300,
				"to": 348540
			},
			"text": " Or don't, that's fine."
		},
		{
			"timestamps": {
				"from": "00:05:49,500",
				"to": "00:05:51,740"
			},
			"offsets": {
				"from": 349500,
				"to": 351740
			},
			"text": " And now I'm going to stop talking."
		},
		{
			"timestamps": {
				"from": "00:05:52,340",
				"to": "00:05:52,760"
			},
			"offsets": {
				"from": 352340,
				"to": 352760
			},
			"text": " Thank you."
		}
	]
}
